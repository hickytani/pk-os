[Unit]
Description=PK Intelligence Assistant Daemon
Documentation=https://github.com/hickytani/pk-os/blob/main/docs/architecture/PK-INTELLIGENCE.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m intelligence.src.daemon
Restart=on-failure
RestartSec=10s
TimeoutStartSec=15s
TimeoutStopSec=8s

# Environment
Environment=PYTHONPATH=/usr/lib/pk-os
Environment=PK_INTELLIGENCE_LOG_LEVEL=INFO

# IPC socket directory
RuntimeDirectory=pk-intelligenced
RuntimeDirectoryMode=0755

# Security hardening
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ReadWritePaths=/run/pk-intelligenced /var/log /tmp
ProtectHome=true

# Resource limits
LimitNOFILE=4096
MemoryMax=256M
CPUQuota=25%

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pk-intelligenced

[Install]
WantedBy=graphical.target multi-user.target
