[Unit]
Description=PK-OS Graphical Shell Session
Documentation=https://github.com/hickytani/pk-os/blob/main/docs/architecture/COMPOSITOR.md
After=systemd-user-sessions.service plymouth-quit-wait.service systemd-udevd.service
Wants=systemd-udevd.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pkos
Group=pkos
SupplementaryGroups=video input render audio tty
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
UtmpIdentifier=tty1
TTYVTDisallocate=yes

# Environment for the graphical session
Environment=LIBSEAT_BACKEND=builtin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_RENDERER=pixman
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=PYTHONPATH=/usr/lib/pk-os
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=pk-os
Environment=GDK_BACKEND=wayland
Environment=PK_DISPLAY_WIDTH=1280
Environment=PK_DISPLAY_HEIGHT=800

ExecStartPre=+/usr/bin/mkdir -p /run/user/1000
ExecStartPre=+/usr/bin/chown -R pkos:pkos /run/user/1000
ExecStartPre=+/usr/bin/chmod 0700 /run/user/1000
# Secure seat access: grant pkos session & VT master access with mode 0660 (zero world-writable bits)
ExecStartPre=+/bin/chown pkos:tty /dev/tty0 /dev/tty1
ExecStartPre=+/bin/chmod 0660 /dev/tty0 /dev/tty1
ExecStartPre=+-/bin/chown -R pkos:video /dev/dri
ExecStartPre=+-/bin/chmod 0755 /dev/dri
ExecStartPre=+-/bin/chmod 0660 /dev/dri/card0 /dev/dri/renderD128
ExecStart=/usr/bin/cage -d -- /usr/bin/python3 -m shell.launcher

# Restart policy: restart on failure, not on clean exit
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=10s

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=graphical.target
